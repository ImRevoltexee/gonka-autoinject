# © MrRevolt
# GonkaRouter API
GONKA_API=https://api.gonkarouter.io
GONKA_ORIGIN=https://gonkarouter.io
GONKA_SITEKEY=0x4AAAAAAFcbQ4RGI69Sc6pz
GONKA_CHANNEL=gonka

# Local state
GONKA_DATA_DIR=./data
GONKA_PROXY_FILE=./data/proxies.txt
GONKA_KEYS_FILE=./data/keys.txt

# Turnstile solver (POST /turnstile {"url","sitekey"} -> {"token"})
GONKA_SOLVER_URL=http://127.0.0.1:407
GONKA_SOLVER_TIMEOUT=180

# Registration loop
GONKA_WORKERS=6
GONKA_MAX_PROXY_ATTEMPTS=5
GONKA_OTP_TIMEOUT=200

# 9Router
ROUTER_BASE=http://127.0.0.1:20128
ROUTER_PASSWORD=change-me
ROUTER_DB=/root/.9router/db/data.sqlite
ROUTER_NODE_NAME=GONKA
ROUTER_NODE_PREFIX=gonka
ROUTER_PROVIDER_BASEURL=https://api.gonkarouter.io/v1
ROUTER_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
ROUTER_POLL_INTERVAL=20
